# Central Orchestrator Server URL
CENTRAL_URL=http://localhost:8000

# Machine Display Name
MACHINE_NAME=Machine-A

# One-time registration token generated from Control Room UI
REGISTRATION_TOKEN=your_registration_token_here

# Execution workspace base directory (default C:\PythonOrchestrator)
WORKSPACE_BASE=C:\PythonOrchestrator

# Keep environments between runs for fast subsequent execution
KEEP_ENVIRONMENT=true

# Cleanup execution workspace after job completes
CLEANUP_AFTER_JOB=false

# Polling and heartbeat intervals in seconds
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=15
