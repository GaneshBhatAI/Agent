# ==============================================================================
# Python GitHub Orchestrator - Central Configuration
# ==============================================================================

# Database Settings
# Local Dev / Testing: sqlite+aiosqlite:///./orchestrator.db
# Docker Production: postgresql+asyncpg://orchestrator:orchestrator_secret_pw@postgres:5432/orchestrator_db
DATABASE_URL=sqlite+aiosqlite:///./orchestrator.db
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator_secret_pw
POSTGRES_DB=orchestrator_db

# Redis Event Bus (Optional)
REDIS_URL=redis://localhost:6379/0

# Security & Encryption Secrets (Change in Production!)
SECRET_KEY=super-secret-production-key-change-this-in-env-file-min-32-chars
AGENT_TOKEN_SECRET=orchestrator-agent-hmac-secret-key-32chars
ENCRYPTION_KEY=

# Default Administrator Account
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@orchestrator.local
INITIAL_ADMIN_PASSWORD=Admin123!

# GitHub Integration (Optional - can also be configured via Web UI)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Agent Timings & Log Retention
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=45
JOB_POLL_INTERVAL_SECONDS=3
DEFAULT_JOB_TIMEOUT_SECONDS=1800
LOG_RETENTION_DAYS=30
